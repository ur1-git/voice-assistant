[Unit]
Description=Hands-free voice assistant
PartOf=graphical-session.target
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service
# Plasma imports DISPLAY and WAYLAND_DISPLAY while starting its desktop session.
After=plasma-core.target

[Service]
Type=exec
# Enable this file by its path so %Y resolves to the project's systemd directory.
ExecStart="%Y/../voice-assistant"
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
